<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared tree identification logic: region pack loading, image preprocessing, on-device model,
       multi-photo fusion, location prior and follow-up questions. Used by the Android app and the Eval tool. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>TreeId</RootNamespace>
    <AssemblyName>TreeCore</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

</Project>
