<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the shared Core code on Windows: runs the region pack's model on the held-out test photos
       and compares accuracy with the Python results, plus a few checks of the follow-up question logic. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>TreeId.Eval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\TreeCore.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

</Project>
