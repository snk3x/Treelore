<Project Sdk="Microsoft.NET.Sdk">

	<!-- Treelore for Android phones. Identifies trees offline from one or more photos; the model, species data
	     and range data ship inside the app as a region pack (Resources/Raw/pack). Shared logic lives in Core. -->
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>TreeMobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Treelore</ApplicationTitle>
		<ApplicationId>com.snk3x.treeid</ApplicationId>
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 7.0 or newer: ONNX Runtime's Android library requires API 24. -->
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- 32-bit ARM for older and budget phones (like the LG K30) plus 64-bit ARM. x64 is left out:
		     only emulators use it, and each extra ABI adds the ONNX Runtime library again. -->
		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<!-- Release builds are signed with the owner's permanent Treelore key when it's on this computer (it is never in the
	     repository). The password comes from the TREELORE_KEYSTORE_PASS environment variable, set only for the build by
	     build-release.ps1. Without it, builds use the debug key and can't update a release-signed install. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(TREELORE_KEYSTORE_PASS)' != '' And Exists('$(USERPROFILE)\Treelore signing\treelore.keystore')">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(USERPROFILE)\Treelore signing\treelore.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>treelore</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>env:TREELORE_KEYSTORE_PASS</AndroidSigningStorePass>
		<AndroidSigningKeyPass>env:TREELORE_KEYSTORE_PASS</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- Use the Android SDK and Java installed in the user profile, when present. -->
	<PropertyGroup>
		<AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
		<JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\jdk')">$(LOCALAPPDATA)\Android\jdk</JavaSdkDirectory>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F4D29" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4D29" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\TreeCore.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

</Project>
